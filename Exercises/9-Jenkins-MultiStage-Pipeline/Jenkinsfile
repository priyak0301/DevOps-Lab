pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                sh '''
                    python3 -m venv .venv
                    .venv/bin/python -m pip install --upgrade pip
                    .venv/bin/python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '''
                    .venv/bin/python -m unittest discover -s . -p 'test_*.py'
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$WORKSPACE/python-app-deploy"
                    cp app.py test_app.py requirements.txt "$WORKSPACE/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    cd "$WORKSPACE/python-app-deploy"
                    nohup "$WORKSPACE/.venv/bin/python" app.py > app.log 2>&1 &
                    echo $! > app.pid
                    sleep 2
                    kill -0 "$(cat app.pid)"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the deployed application over HTTP...'
                sh '''
                    .venv/bin/python - <<'PY'
import time
from urllib.request import urlopen

url = "http://127.0.0.1:5000/"
last_error = None

for attempt in range(10):
    try:
        with urlopen(url, timeout=2) as response:
            body = response.read().decode("utf-8")
            assert response.status == 200, f"Unexpected status: {response.status}"
            assert body == "Hello, Jenkins Multi-Stage Pipeline!", f"Unexpected response: {body}"
            print("HTTP status:", response.status)
            print("Application response:", body)
            break
    except Exception as error:
        last_error = error
        time.sleep(1)
else:
    raise RuntimeError(f"Application HTTP test failed: {last_error}")
PY
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
