
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Exercise 7: Jenkins CI Pipeline'
            }
        }

        stage('Build') {
            steps {
                echo 'Checking project files'
                sh 'ls -la'
                sh 'test -d Exercises'
            }
        }

        stage('Test') {
            steps {
                echo 'Running automated Python tests'
                sh 'python3 -m unittest discover -s Exercises/7-Jenkins-CI/tests -p "test_*.py"'
            }
        }
    }

    post {
        success {
            echo 'All pipeline stages completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}
